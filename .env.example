# ---------------------------------------------------------------------------
# Windii Technologies — environment variables
#
# Copy this file to `.env.local` for development, and set the same values in
# your host's environment panel for production. Never commit `.env.local`.
# ---------------------------------------------------------------------------


# --- Contact form email delivery ---------------------------------------------
#
# Two transports are implemented. Configure ONE of them.
#   - Resend  : recommended on Vercel and any serverless host (HTTP, no SMTP port)
#   - SMTP    : recommended on cPanel / shared hosting, where you already have a
#               mailbox for info@windiitechnologies.com
#
# Leave MAIL_TRANSPORT unset to auto-detect: Resend is used if RESEND_API_KEY is
# present, otherwise SMTP if SMTP_HOST is present. Set it explicitly to force one.
#
# MAIL_TRANSPORT=resend
# MAIL_TRANSPORT=smtp


# --- Option A: Resend ---------------------------------------------------------
# Create a key at https://resend.com/api-keys and verify the sending domain
# (windiitechnologies.com) in the Resend dashboard first. See DNS-AND-EMAIL.md.
RESEND_API_KEY=


# --- Option B: SMTP (Nodemailer) ---------------------------------------------
# Use the outgoing mail settings from your hosting control panel.
# Port 465 = implicit TLS, port 587 = STARTTLS. SMTP_SECURE is inferred from the
# port unless you set it explicitly.
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=


# --- Addresses ----------------------------------------------------------------
# Where enquiries are delivered. Defaults to the business email in
# src/content/site.ts if unset.
CONTACT_TO_EMAIL=info@windiitechnologies.com

# The From address enquiries are sent as. This MUST be an address on a domain
# you have authorised for sending (SPF/DKIM), otherwise mail will be rejected or
# land in spam. Do not put the visitor's address here — their address is set as
# Reply-To automatically.
CONTACT_FROM_EMAIL="Windii Technologies <no-reply@windiitechnologies.com>"


# --- Site URL -----------------------------------------------------------------
# The canonical site URL lives in src/content/site.ts and defaults to
# https://windiitechnologies.com. Set this ONLY for preview/staging deployments
# that run on a different hostname; leave it unset in production so canonical
# URLs, the sitemap and the JSON-LD all point at the real domain.
# NEXT_PUBLIC_SITE_URL=https://staging.windiitechnologies.com
